{
  "name": "webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vitest run src || true && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:coverage": "vitest run --coverage src",
    "test:watch": "vitest --watch src",
    "test:e2e:run": "cucumber-js --import test/e2e/support/setup.mjs --import test/e2e/steps/*.mjs test/e2e/features --format progress",
    "test:e2e:install-browsers": "playwright install --with-deps",
    "test:e2e:chromium": "cross-env BROWSER=chromium npm run test:e2e:run",
    "test:e2e:firefox": "cross-env BROWSER=firefox npm run test:e2e:run",
    "test:e2e:webkit": "cross-env BROWSER=webkit npm run test:e2e:run",
    "test:e2e:all": "concurrently \"npm run test:e2e:chromium\" \"npm run test:e2e:firefox\" \"npm run test:e2e:webkit\"",
    "test:e2e": "start-server-and-test start:all http://localhost/ test:e2e:all",
    "start:all": "docker compose up"


  },
  "dependencies": {
    "eslint": "^9.39.3",
    "konva": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "react-router-dom": "^6.30.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.4.0",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^8.2.0",
    "jsdom": "^22.1.0",
    "playwright": "^1.43.0",
    "start-server-and-test": "^2.1.3",
    "ts-node": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16",
    "vitest-sonar-reporter": "^3.0.0"
  }
}
